<configuration>
    <property name="SERVICE" value="patient-service"/>
    <property name="LOG_PATH" value="./docker/elk-stack-distributed-logging/filebeat/logs/${SERVICE}}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level  --- [%X{spring.application.name}] [%thread] [%X{traceId}-%X{spanId}] %logger{36} : %msg%n"/>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${SERVICE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <customFields>{"service":"${SERVICE}"}</customFields>
        </encoder>
    </appender>

    <!-- Ghi ra CONSOLE (hiển thị terminal/Docker logs) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
